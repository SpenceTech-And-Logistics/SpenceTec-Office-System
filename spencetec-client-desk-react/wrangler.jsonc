{
  "name": "spencetec-office-system",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  // Keep the custom domain in the config so every deploy keeps it attached.
  "routes": [{ "pattern": "desk.spencetec.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spencetec-client-desk",
      "database_id": "c7f9d54f-87b4-4917-8d28-d965659956f3",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "OWNER_EMAIL": "davidspec580@gmail.com",
    "MAIL_FROM": "SpenceTec Client Desk <desk@spencetec.com>",
  },
}
